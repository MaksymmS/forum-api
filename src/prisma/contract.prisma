// use prisma-8

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  author    String?
  categoryId Int?
  category   Category?  @relation(fields: [categoryId], references: [id])
  createdAt  DateTime   @default(now())
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique
  posts Post[]
}